# ============== COMPRESSION FUNCTIONS ==============
def compress_encrypted_key(encrypted_key):
    if not encrypted_key:
        return encrypted_key
    decoded = base64.b64decode(encrypted_key)
    compressed = zlib.compress(decoded, level=9)
    print(f"   🔍 Size: {len(encrypted_key)} chars → {len(decoded)} bytes → {len(compressed)} bytes")
    return compressed

def decompress_encrypted_key(compressed_key):
    if not compressed_key:
        return compressed_key
    decompressed = zlib.decompress(compressed_key)
    return base64.b64encode(decompressed).decode()

