# ============== BLOCKCHAIN HELPER FUNCTIONS ==============

def register_device_on_blockchain(virtual_id, device_type, public_key, encrypted_private_key):
    global blockchain_stored_devices
    if not ganache_connected or contract is None:
        return False, "Blockchain not connected"
    try:
        print(f"
🔗 Registering device on Blockchain...")
        print(f"   Virtual ID: {virtual_id}")
        
        # Fix base64 padding and compress
        key_str = encrypted_private_key.strip()
        missing_padding = len(key_str) % 4
        if missing_padding:
            key_str += '=' * (4 - missing_padding)
        
        decoded_bytes = base64.b64decode(key_str)
        compressed_bytes = zlib.compress(decoded_bytes, level=9)
        print(f"   🔍 Original: {len(encrypted_private_key)} chars")
        print(f"   🔍 Decoded: {len(decoded_bytes)} bytes")
        print(f"   🔍 Compressed: {len(compressed_bytes)} bytes (saved {len(decoded_bytes) - len(compressed_bytes)} bytes)")
        
        account = ganache_client.eth.accounts[0]
        
        tx = contract.functions.registerDevice(
            virtual_id, 
            device_type, 
            public_key,
            compressed_bytes
        ).transact({
            'from': account,
            'gas': 100000000,
            'gasPrice': 20000000000
        })
        
        receipt = ganache_client.eth.wait_for_transaction_receipt(tx)
        print(f"✅ Device registered on Blockchain!")
        print(f"   Transaction Hash: {receipt.transactionHash.hex()}")
        print(f"   Gas Used: {receipt.gasUsed}")
        
        blockchain_stored_devices.add(virtual_id)
        print(f"   Added to blockchain_stored_devices. Total: {len(blockchain_stored_devices)}")
        
        return True, receipt.transactionHash.hex()
    except Exception as e:
        print(f"❌ Blockchain registration failed: {e}")
        return False, str(e)

def get_blockchain_device_count():
    if not ganache_connected or contract is None:
        return 0
    try:
        count = contract.functions.getTotalDevices().call()
        print(f"📊 Blockchain device count from contract: {count}")
        return count
    except Exception as e:
        print(f"❌ Error getting device count: {e}")
        return 0

def get_public_key_from_blockchain(virtual_id):
    if not ganache_connected or contract is None:
        return None
    try:
        device = contract.functions.getDevice(virtual_id).call()
        return device[2]
    except Exception as e:
        print(f"⚠️ Could not get public key: {e}")
        return None

def get_encrypted_private_key_from_blockchain(virtual_id):
    if not ganache_connected or contract is None:
        return None
    try:
        device = contract.functions.getDevice(virtual_id).call()
        encrypted_key_bytes = device[3]
        encrypted_key_str = encrypted_key_bytes.decode('utf-8')
        print(f"✅ Retrieved encrypted key length: {len(encrypted_key_str)}")
        return encrypted_key_str
    except Exception as e:
        print(f"⚠️ Could not get encrypted private key: {e}")
        return None

